PORT=4000
FRONTEND_URL=http://localhost:3000
# Generate a long random secret for signing admin sessions.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Supabase: use the Session Pooler URI from Project Settings > Database.
# Download the project's root certificate from Database settings and save it here:
# backend/certs/supabase-root.crt
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/rrms
# Used by `npm run db:seed-admin --workspace backend` to create the first admin.
ADMIN_SEED_NAME=RRMS Administrator
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Used by `npm run db:seed-member --workspace backend` to create a team member.
TEAM_MEMBER_SEED_NAME=Sample Team Member
TEAM_MEMBER_SEED_EMAIL=member@example.com
TEAM_MEMBER_SEED_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Required only for Supabase; path is relative to the backend/ directory.
# DATABASE_CA_CERT=./certs/supabase-root.crt
