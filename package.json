{
  "name": "rrms",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p frontend/tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p backend/tsconfig.json",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed-admin": "npm run db:seed-admin --workspace backend",
    "db:seed-member": "npm run db:seed-member --workspace backend"
  }
}
